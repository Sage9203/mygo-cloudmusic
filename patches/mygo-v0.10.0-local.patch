diff --git a/vendor/github.com/egoist/mygo/audio/output_drain_test.go b/vendor/github.com/egoist/mygo/audio/output_drain_test.go
new file mode 100644
index 0000000..4e833e9
--- /dev/null
+++ b/vendor/github.com/egoist/mygo/audio/output_drain_test.go
@@ -0,0 +1,73 @@
+package audio
+
+import (
+	"errors"
+	"slices"
+	"testing"
+)
+
+type queuedDevice struct {
+	pending, heard []float32
+	closed         bool
+	fail           bool
+}
+
+func (d *queuedDevice) write(samples []float32) error {
+	d.pending = append(d.pending, samples...)
+	if d.fail {
+		return errors.New("device removed")
+	}
+	mu.Lock()
+	requestedFormat = outputFormat{rate: 96000}
+	mu.Unlock()
+	return nil
+}
+func (d *queuedDevice) drain() { d.heard = append(d.heard, d.pending...); d.pending = nil }
+func (d *queuedDevice) close() { d.pending = nil; d.closed = true }
+
+// A sample-rate change must play already-queued tail samples before closing the old output.
+func TestFormatChangePreservesQueuedTail(t *testing.T) {
+	testQueuedTail(t, false)
+}
+
+// A removed device must close directly rather than wait for playback it cannot finish.
+func TestDeviceFailureSkipsDrain(t *testing.T) {
+	testQueuedTail(t, true)
+}
+
+func testQueuedTail(t *testing.T, fail bool) {
+	t.Helper()
+	mu.Lock()
+	oldFormat, oldRate, oldVoices, oldVolume := requestedFormat, mixRate, voices, volume
+	oldMixed, oldUnheard, oldHeld := mixed, unheard, held
+	oldTestMode := testMode
+	defer func() {
+		mu.Lock()
+		requestedFormat, mixRate, voices, volume = oldFormat, oldRate, oldVoices, oldVolume
+		mixed, unheard, held = oldMixed, oldUnheard, oldHeld
+		testMode = oldTestMode
+		mu.Unlock()
+	}()
+	format := outputFormat{rate: 48000}
+	requestedFormat, mixRate, volume = format, format.rate, 1
+	// Drive the fake device directly without waking the background output.
+	testMode = false
+	mixed, unheard, held = 0, 0, 4800
+	samples := []float32{0.25, -0.25}
+	p := newPlayer(&memSource{samples: samples, channels: 2}, format.rate, 2, 1)
+	p.v.playing, p.v.active, p.v.snap = true, true, true
+	voices = []*voice{p.v}
+	mu.Unlock()
+	d := &queuedDevice{fail: fail}
+	playDevice(d, 1, outputLatency(), format)
+	if !d.closed {
+		t.Fatal("output left open")
+	}
+	if fail {
+		if len(d.heard) != 0 {
+			t.Fatal("attempted to drain a failed output")
+		}
+	} else if !slices.Equal(d.heard, samples) {
+		t.Fatalf("queued tail lost during format change: heard %v, want %v", d.heard, samples)
+	}
+}
diff --git a/vendor/github.com/egoist/mygo/audio/output_format.go b/vendor/github.com/egoist/mygo/audio/output_format.go
new file mode 100644
index 0000000..9acade5
--- /dev/null
+++ b/vendor/github.com/egoist/mygo/audio/output_format.go
@@ -0,0 +1,74 @@
+package audio
+
+import (
+	"fmt"
+	"runtime"
+)
+
+// Local extension: Windows can open each track at its decoded sample rate.
+// requestedFormat and mixRate are protected by mu; other platforms retain 48 kHz.
+type outputFormat struct {
+	rate      int
+	exclusive bool
+}
+
+var requestedFormat = outputFormat{rate: sampleRate}
+var mixRate = sampleRate
+var outputStatus = "尚未打开音频设备"
+var outputMixStatus = "尚未读取"
+
+// OutputMixStatus is the engine's shared mix format at the last successful open.
+// It is not the hardware/DAC format, and exclusive playback bypasses this mixer.
+func OutputMixStatus() string {
+	errMu.Lock()
+	defer errMu.Unlock()
+	return outputMixStatus
+}
+
+// ConfigureOutput selects the next Windows stream's sample rate and mode.
+// Reopening is done on the output thread, never on the caller's UI thread.
+func ConfigureOutput(rate int, exclusive bool) {
+	if runtime.GOOS != "windows" {
+		return
+	}
+	if rate <= 0 {
+		rate = sampleRate
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	f := outputFormat{rate, exclusive}
+	if requestedFormat != f {
+		requestedFormat = f
+		wakeOutput()
+	}
+}
+
+func outputSettings() outputFormat {
+	mu.Lock()
+	defer mu.Unlock()
+	return requestedFormat
+}
+
+// OutputStatus describes the last successfully opened stream, not its source.
+func OutputStatus() string {
+	errMu.Lock()
+	defer errMu.Unlock()
+	if outErr != nil {
+		return "输出不可用：" + outErr.Error()
+	}
+	return outputStatus
+}
+
+func setOutputStatus(rate, bits int, exclusive bool, fallback error) {
+	mode := "共享，Windows 可能按设备格式转换"
+	if exclusive {
+		mode = "独占"
+	}
