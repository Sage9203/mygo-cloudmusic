+	out := render(rampFrames + 10)
+	if !(out[0] > 0.45 && out[2*(rampFrames/2)] < 0.3 && out[2*(rampFrames/2)] > 0.2) {
+		t.Errorf("fade out = %v, %v", out[0], out[2*(rampFrames/2)])
