+// Upstream timing assertions render their fixtures at the default rate.
+const rampFrames = sampleRate / 200
+
+// setup mixes by hand, with nothing playing.
+func setup(t *testing.T) {
+	t.Helper()
+	mu.Lock()
+	testMode = true
+	for _, v := range voices {
+		v.active = false
+	}
+	voices = nil
+	volume = 1
+	mixRate = sampleRate
+	requestedFormat = outputFormat{rate: sampleRate}
+	held, unheard = 0, 0
+	mu.Unlock()
+}
+
+// hold makes the output hold n frames ahead of what is heard, as a device
+// that just opened.
+func hold(n int64) {
+	mu.Lock()
+	defer mu.Unlock()
+	held, unheard = n, 0
+}
+
+// render mixes n frames.
+func render(n int) []float32 {
+	out := make([]float32, n*channels)
+	for i := 0; i < n; i += 256 {
+		mix(out[i*channels : min(n, i+256)*channels])
+	}
+	return out
+}
+
+func near(a, b float32) bool { return math.Abs(float64(a-b)) < 1e-4 }
+
+func ramp(n int) []float32 {
+	s := make([]float32, n)
+	for i := range s {
+		s[i] = float32(i%100) / 200
+	}
+	return s
+}
