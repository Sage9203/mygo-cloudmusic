+// device is accepted and the actual depth is shown, never labelled 24-bit.
+func exclusiveFormats(rate int) []waveFormatExtensible {
+	pcm := guid{0x00000001, 0, 0x0010, [8]byte{0x80, 0, 0, 0xaa, 0, 0x38, 0x9b, 0x71}}
+	var result []waveFormatExtensible
+	for _, spec := range []struct {
+		bits, valid uint16
+		subtype     guid
+	}{
+		{32, 32, ksDataFormatSubtypeFloat}, {32, 32, pcm}, {32, 24, pcm}, {24, 24, pcm}, {16, 16, pcm},
+	} {
+		align := spec.bits / 8 * channels
+		result = append(result, waveFormatExtensible{waveFormatExtensibleTag, channels, uint32(rate), uint32(rate) * uint32(align), align, spec.bits, 22, spec.valid, speakerFrontLeft | speakerFrontRight, spec.subtype})
+	}
+	return result
+}
+
+func encodeOutput(dst []byte, samples []float32, f waveFormatExtensible) {
+	if f.subFormat == ksDataFormatSubtypeFloat {
+		copy(unsafe.Slice((*float32)(unsafe.Pointer(&dst[0])), len(samples)), samples)
+		return
+	}
+	width := int(f.bitsPerSample / 8)
+	shift := f.bitsPerSample - f.validBits
+	scale := math.Ldexp(1, int(f.validBits)-1)
+	for i, sample := range samples {
+		x := math.Round(float64(sample) * scale)
+		x = min(max(x, -scale), scale-1)
+		v := uint32(int32(int64(x) << shift))
+		for b := 0; b < width; b++ {
+			dst[i*width+b] = byte(v >> (8 * b))
+		}
+	}
+}
diff --git a/vendor/github.com/egoist/mygo/audio/position_test.go b/vendor/github.com/egoist/mygo/audio/position_test.go
new file mode 100644
index 0000000..84793fd
--- /dev/null
+++ b/vendor/github.com/egoist/mygo/audio/position_test.go
@@ -0,0 +1,138 @@
+package audio
+
+import (
+	"testing"
+	"time"
+)
+
+// heldFrames is what the output holds ahead in these tests: 100 ms.
+const heldFrames = sampleRate / 10
+
+// atFrame checks that p's position is source frame f.
+func atFrame(t *testing.T, p *Player, f int64, when string) {
+	t.Helper()
+	got, want := p.Position(), frames(f, sampleRate)
+	if d := got - want; d < -time.Microsecond || d > time.Microsecond {
+		t.Errorf("%s: Position = %v, want %v (frame %d)", when, got, want, f)
+	}
+}
+
+func longSound() *Sound { return NewSound(sampleRate, 1, make([]float32, 10*sampleRate)) }
+
+// Position is what is heard: it stands still while the device fills, and
+// then lags what was mixed by what the device holds.
+func TestPositionIsHeard(t *testing.T) {
+	setup(t)
+	hold(heldFrames)
+	p := longSound().Play()
+	render(heldFrames / 2)
+	atFrame(t, p, 0, "half the device filled")
+	render(heldFrames / 2)
+	atFrame(t, p, 0, "the device filled")
+	render(3000)
+	atFrame(t, p, 3000, "3000 frames on")
+	// A device opening again holds nothing of what was mixed before,
+	// which it dropped: the position goes on from what was mixed.
+	hold(heldFrames)
+	atFrame(t, p, heldFrames+3000, "a device opened again")
+}
+
+// Right after a seek, Position is where it seeked to, and goes on from
+// there once the device plays what was mixed since.
+func TestPositionHoldsAtSeek(t *testing.T) {
+	setup(t)
+	hold(heldFrames)
+	p := longSound().Play()
+	render(2 * heldFrames)
+	p.Seek(2 * time.Second)
+	atFrame(t, p, 2*sampleRate, "right after Seek")
+	render(heldFrames - 100)
+	atFrame(t, p, 2*sampleRate, "before the seek is heard")
+	render(600)
+	atFrame(t, p, 2*sampleRate+500, "500 frames into the seek heard")
+	p.Stop()
+	atFrame(t, p, 0, "after Stop")
+}
+
+// Paused, a player goes on for as long as the device plays what it holds,
+// then stands still; playing again, it stands still until that is heard.
+func TestPositionPlaysOutPause(t *testing.T) {
+	setup(t)
+	hold(heldFrames)
+	p := longSound().Play()
+	render(10000)
+	p.Pause()
+	atFrame(t, p, 10000-heldFrames, "at Pause")
+	render(2000)
+	atFrame(t, p, 12000-heldFrames, "2000 frames after Pause")
+	// It faded out over rampFrames after the pause.
+	render(2 * heldFrames)
+	atFrame(t, p, 10000+rampFrames, "played out")
+	render(1000)
+	atFrame(t, p, 10000+rampFrames, "paused, played out")
+	p.Play()
+	render(heldFrames - 100)
+	atFrame(t, p, 10000+rampFrames, "before playing again is heard")
+	render(600)
+	atFrame(t, p, 10000+rampFrames+500, "500 frames into playing again")
+}
+
+// With a speed, what the device holds is that many more frames of the
+// source.
+func TestPositionAtSpeed(t *testing.T) {
+	setup(t)
+	hold(heldFrames)
+	p := longSound().NewPlayer().SetSpeed(2)
+	p.Play()
+	render(3 * heldFrames)
+	atFrame(t, p, 4*heldFrames, "200 ms heard at speed 2")
+	p.SetSpeed(0.5)
+	render(heldFrames * 3 / 2)
+	// Of the 150 ms heard since, 100 ms were mixed at 2, 50 ms at 0.5.
+	atFrame(t, p, 4*heldFrames+2*heldFrames+heldFrames/4, "after slowing down")
+}
+
+// A looping player's position heard comes back to the loop's start.
+func TestPositionWrapsLoops(t *testing.T) {
+	setup(t)
+	hold(50)
+	p := NewSound(sampleRate, 1, ramp(100)).NewPlayer().
+		SetLoopRange(frames(30, sampleRate), frames(60, sampleRate))
+	p.Play()
+	render(160)
+	atFrame(t, p, 50, "110 frames heard")
+	render(10)
+	// 120 heard: 60, then two loops of 30.
+	atFrame(t, p, 30, "120 frames heard")
+}
+
+// A stream that is late stands still while it is, as heard.
+func TestLateStreamPositionIsHeard(t *testing.T) {
+	setup(t)
+	hold(heldFrames)
+	src := &lateSource{ready: 1000}
+	p := newPlayer(src, sampleRate, 1, -1)
+	p.Play()
+	// It plays 998 frames of the 1000, reading two ahead to interpolate,
+	// then waits for 1002.
+	render(heldFrames + 2000)
+	src.ready = 1 << 30
+	render(500)
+	atFrame(t, p, 998, "the device playing the wait")
+	render(heldFrames)
+	atFrame(t, p, 998+500, "the wait heard")
+}
+
+// A lateSource has ready frames decoded, and then waits for more.
+type lateSource struct{ ready int }
+
+func (s *lateSource) read(dst []float32) (int, bool) {
+	n := min(len(dst), s.ready)
+	clear(dst[:n])
+	s.ready -= n
+	return n, false
+}
+
+func (*lateSource) seek(int64)                 {}
+func (*lateSource) setLoop(bool, int64, int64) {}
+func (*lateSource) close()                     {}
diff --git a/vendor/github.com/egoist/mygo/audio/resample_test.go b/vendor/github.com/egoist/mygo/audio/resample_test.go
new file mode 100644
index 0000000..3466bb0
--- /dev/null
+++ b/vendor/github.com/egoist/mygo/audio/resample_test.go
@@ -0,0 +1,212 @@
+package audio
+
+import (
+	"fmt"
+	"math"
+	"testing"
+	"time"
+)
+
+// Mixing one looping stereo voice, a buffer of 10 ms at a time, at the
+// rates sounds come in.
+func BenchmarkMix(b *testing.B) {
+	for _, rate := range []int{44100, 48000, 88200, 96000, 192000} {
+		b.Run(fmt.Sprint(rate), func(b *testing.B) {
+			mu.Lock()
+			testMode = true
+			voices = nil
+			volume = 1
+			mu.Unlock()
+			NewSound(rate, 2, sine(rate, 1, 440, 660)).NewPlayer().SetLoop(true).Play()
+			buf := make([]float32, sampleRate/100*channels)
+			// The first allocates the voice's ring, and its kernels.
+			mix(buf)
+			b.ReportAllocs()
+			for b.Loop() {
+				mix(buf)
+			}
+		})
+	}
+}
+
+func TestDownsampleAlias(t *testing.T) {
+	for _, tc := range []struct {
+		name              string
+		rate, tone, alias int // Hz
+	}{
+		{"88k2", 88200, 30000, 18000},
+		{"96k", 96000, 30000, 18000},
+		{"192k", 192000, 90000, 6000},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			setup(t)
+			input := make([]float32, 2*tc.rate)
+			for i := range tc.rate {
+				phase := 2 * math.Pi * float64(i) / float64(tc.rate)
+				input[2*i] = float32(0.1 * math.Sin(6000*phase))
+				input[2*i+1] = float32(0.1 * math.Sin(float64(tc.tone)*phase))
+			}
+			NewSound(tc.rate, 2, input).Play()
+			out := render(9600)[2*4800:] // Analyze 100 ms after startup.
+			pass := measuredAmplitude(out, 0, 6000)
+			alias := measuredAmplitude(out, 1, tc.alias)
+			t.Logf("control %.6f, alias %.6f", pass, alias)
+			if math.Abs(pass-0.1) > 0.005 {
+				t.Fatalf("invalid passband control: %g", pass)
+			}
+			if alias > 0.1*0.001 {
+				t.Errorf("alias at %d Hz exceeds -60 dB relative to input", tc.alias)
+			}
+		})
+	}
+}
+
+// measuredAmplitude returns the peak amplitude of channel ch of out at hz.
+func measuredAmplitude(out []float32, ch, hz int) float64 {
+	var re, im float64
+	n := len(out) / 2
+	for i := range n {
+		phase := 2 * math.Pi * float64(hz*i) / 48000
+		x := float64(out[2*i+ch])
+		re += x * math.Cos(phase)
+		im += x * math.Sin(phase)
+	}
+	return 2 * math.Hypot(re, im) / float64(n)
+}
+
+// fold returns the frequency that hz plays at at the output's rate.
+func fold(hz int) int {
+	hz %= sampleRate
+	return min(hz, sampleRate-hz)
+}
+
+// Downsampled, what is below 20 kHz plays as it is, within 0.1 dB, and
+// where the source is.
+func TestDownsamplePassband(t *testing.T) {
+	for _, rate := range []int{88200, 96000, 192000} {
+		for _, hz := range [][2]float64{{1000, 15000}, {6000, 20000}} {
+			setup(t)
+			p := NewSound(rate, 2, sine(rate, 0.5, hz[0], hz[1])).Play()
+			out := render(9600)
+			for c, f := range hz {
+				got := measuredAmplitude(out[2*4800:], c, int(f))
+				if db := 20 * math.Log10(got/0.5); math.Abs(db) > 0.1 {
+					t.Errorf("%d Hz at %d Hz plays at %+.3f dB", int(f), rate, db)
+				}
+			}
+			if got, want := p.Position(), 200*time.Millisecond; got-want > time.Microsecond || want-got > time.Microsecond {
+				t.Errorf("at %d Hz: Position = %v, want %v", rate, got, want)
+			}
+		}
+	}
+}
+
+// Downsampled, at the sound's rate or its speed, what is above 24 kHz
+// does not fold back below it: 80 dB down from 24.5 kHz.
+func TestDownsampleStopband(t *testing.T) {
+	// A sound at rate played at speed: a tone of pass Hz on the left, one
+	// of stop Hz on the right.
+	type tones struct {
+		rate       int
+		speed      float64
+		pass, stop int
+	}
+	var cases []tones
+	for _, rate := range []int{88200, 96000, 192000} {
+		for hz := 24500; hz < rate/2; hz += 3000 + hz/4 {
+			cases = append(cases, tones{rate, 1, 1000, hz})
+		}
+	}
+	cases = append(cases,
+		tones{48000, 1.25, 1000, 20000}, // 25 kHz
+		tones{44100, 2, 1000, 15000},    // 30 kHz
+		tones{96000, 3, 1000, 9000},     // 27 kHz
+		// Wider kernels than the ring holds.
+		tones{48000, 12, 1000, 2500}, // 30 kHz
+		tones{96000, 16, 500, 2000},  // 32 kHz
+		tones{192000, 16, 250, 4000}, // 64 kHz
+		tones{96000, 16, 500, 1580},  // 25.3 kHz
+	)
+	for _, tc := range cases {
+		setup(t)
+		p := NewSound(tc.rate, 2, sine(tc.rate, 0.25*tc.speed, float64(tc.pass), float64(tc.stop))).NewPlayer()
+		p.SetSpeed(tc.speed).Play()
+		out := render(9600)[2*4800:]
+		heard := int(float64(tc.stop) * tc.speed)
+		pass := measuredAmplitude(out, 0, int(float64(tc.pass)*tc.speed))
+		alias := measuredAmplitude(out, 1, fold(heard))
+		if db := 20 * math.Log10(pass/0.5); math.Abs(db) > 0.1 {
+			t.Errorf("%d Hz at %v×: %v Hz plays at %+.3f dB", tc.rate, tc.speed, float64(tc.pass)*tc.speed, db)
+		}
+		if db := 20 * math.Log10(alias/0.5); db > -80 {
+			t.Errorf("%d Hz at %v×: %d Hz folds to %d Hz at %.1f dB", tc.rate, tc.speed, heard, fold(heard), db)
+		}
+	}
+}
+
+// Downsampling goes on from one buffer to the next as if it mixed them
+// all at once.
+func TestDownsampleAcrossBuffers(t *testing.T) {
+	const n = 9600
+	samples := sine(88200, 0.2, 1000, 17000)
+	for i := 1000; i < 1100; i++ {
+		// A step, which rings.
+		samples[2*i] += 0.3
+	}
+	setup(t)
+	NewSound(88200, 2, samples).Play()
+	whole := make([]float32, n*channels)
+	mix(whole)
+	setup(t)
+	NewSound(88200, 2, samples).Play()
+	parts := make([]float32, n*channels)
+	sizes := []int{1, 7, 64, 333, 2, 480, 129}
+	for i, k := 0, 0; i < n; k++ {
+		m := min(sizes[k%len(sizes)], n-i)
+		mix(parts[i*channels : (i+m)*channels])
+		i += m
+	}
+	for i := range whole {
+		if whole[i] != parts[i] {
+			t.Fatalf("frame %d channel %d = %v in parts, %v at once", i/2, i%2, parts[i], whole[i])
+		}
+	}
+}
+
+// Changing speed, a voice goes from the spline to the sinc and back, and
+// from one kernel to another, without a click.
+func TestDownsampleSpeedChanges(t *testing.T) {
+	setup(t)
+	p := NewSound(sampleRate, 1, sine(sampleRate, 2, 1000)).NewPlayer()
+	p.Play()
+	var out []float32
+	for _, s := range []float64{1, 1.5, 3, 0.8, 2, 9, 1} {
+		p.SetSpeed(s)
+		out = append(out, render(480)...)
+	}
+	// The steepest a sine of 0.5 at 9 kHz is.
+	steep := 2 * math.Pi * 9000 / sampleRate * 0.5
+	for i := 1; i < len(out)/2; i++ {
+		if d := math.Abs(float64(out[2*i] - out[2*(i-1)])); d > 1.05*steep {
+			t.Fatalf("a click at frame %d: %v to %v", i, out[2*(i-1)], out[2*i])
+		}
+	}
+}
+
+// Downsampling allocates nothing as it mixes, as its speed changes.
+func TestDownsampleAllocatesNothing(t *testing.T) {
+	setup(t)
+	p := NewSound(96000, 2, sine(96000, 0.5, 200, 300)).NewPlayer().SetLoop(true)
+	p.Play()
+	buf := make([]float32, 480*channels)
+	speeds := []float64{1, 1.3, 0.7, 3.7, 12, 1.001}
+	i := 0
+	if n := testing.AllocsPerRun(600, func() {
+		mix(buf)
+		if i++; i%50 == 0 {
+			p.SetSpeed(speeds[i/50%len(speeds)])
+		}
+	}); n != 0 {
+		t.Errorf("%v allocations a buffer", n)
+	}
+}
diff --git a/vendor/github.com/egoist/mygo/audio/stretch_test.go b/vendor/github.com/egoist/mygo/audio/stretch_test.go
new file mode 100644
index 0000000..770d7bc
--- /dev/null
+++ b/vendor/github.com/egoist/mygo/audio/stretch_test.go
@@ -0,0 +1,337 @@
+package audio
+
+import (
+	"io"
+	"math"
+	"testing"
+	"time"
+)
+
+// sine returns secs of sines of amplitude 0.5 at rate, one frequency for
+// each channel.
+func sine(rate int, secs float64, freqs ...float64) []float32 {
+	ch := len(freqs)
+	n := int(secs * float64(rate))
+	s := make([]float32, n*ch)
+	for i := range n {
+		for c, f := range freqs {
+			s[i*ch+c] = float32(0.5 * math.Sin(2*math.Pi*f*float64(i)/float64(rate)))
+		}
+	}
+	return s
+}
+
+// channel returns channel c of out, interleaved stereo, from frame from
+// to frame to.
+func channel(out []float32, c, from, to int) []float32 {
+	x := make([]float32, to-from)
+	for i := range x {
+		x[i] = out[2*(from+i)+c]
+	}
+	return x
+}
+
+// dominant returns the frequency, to the hertz, of x's strongest
+// component between 50 Hz and 2 kHz, by the Goertzel algorithm.
+func dominant(x []float32) float64 {
+	best, at := 0.0, 0.0
+	for f := 50.0; f <= 2000; f++ {
+		w := 2 * math.Pi * f / sampleRate
+		c := 2 * math.Cos(w)
+		var s1, s2 float64
+		for _, v := range x {
+			s1, s2 = float64(v)+c*s1-s2, s1
+		}
+		if p := s1*s1 + s2*s2 - c*s1*s2; p > best {
+			best, at = p, f
+		}
+	}
+	return at
+}
+
+// smooth checks that channel c of out, a sine of amplitude 0.5 at up to
+// maxHz, has no click and no gap from frame from to frame to: no step
+// between frames much larger than the sine's steepest, and no period
+// without its peaks.
+func smooth(t *testing.T, out []float32, c, from, to int, maxHz float64, what string) {
+	t.Helper()
+	steep := 2 * math.Pi * maxHz * 0.5 / sampleRate
+	for i := from + 1; i < to; i++ {
+		if d := math.Abs(float64(out[2*i+c] - out[2*(i-1)+c])); d > 1.6*steep {
+			t.Fatalf("%s: a click at frame %d: %v to %v", what, i, out[2*(i-1)+c], out[2*i+c])
+		}
+	}
+	period := int(sampleRate/maxHz*2) + 1
+	for i := from; i+period <= to; i += period / 2 {
+		peak := float32(0)
+		for _, v := range channel(out, c, i, i+period) {
+			peak = max(peak, v, -v)
+		}
+		if peak < 0.35 {
+			t.Fatalf("%s: a gap at frame %d: peak %v", what, i, peak)
+		}
+	}
+}
+
+// renderToEnd mixes p until it ends, and returns what it mixed.
+func renderToEnd(t *testing.T, p *Player) []float32 {
+	t.Helper()
+	var out []float32
+	for p.Playing() {
+		out = append(out, render(256)...)
+		if len(out) > 60*sampleRate*channels {
+			t.Fatal("a minute and not at its end")
+		}
+	}
+	return out
+}
+
+// framesPlayed returns the frames of out up to its last that is not silent.
+func framesPlayed(out []float32) int {
+	for i := len(out)/2 - 1; i >= 0; i-- {
+		if out[2*i] != 0 || out[2*i+1] != 0 {
+			return i + 1
+		}
+	}
+	return 0
+}
+
+// At 1.5×, a sine stretched keeps its frequency, and one resampled, the
+// default, rises a fifth.
+func TestPreservesPitch(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		rate  int
+		freqs []float64
+	}{
+		{"mono", sampleRate, []float64{220}},
+		{"stereo", sampleRate, []float64{200, 300}},
+		{"mono at 24 kHz", 24000, []float64{220}},
+		{"stereo at 96 kHz", 96000, []float64{200, 300}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := NewSound(tc.rate, len(tc.freqs), sine(tc.rate, 2, tc.freqs...))
+			for _, keep := range []bool{true, false} {
+				setup(t)
+				p := s.NewPlayer().SetSpeed(1.5)
+				if keep {
+					p.SetPreservesPitch(true)
+				}
+				p.Play()
+				out := render(sampleRate)
+				for c := range 2 {
+					f := tc.freqs[min(c, len(tc.freqs)-1)]
+					want := f
+					if !keep {
+						want = f * 1.5
+					}
+					if got := dominant(channel(out, c, sampleRate/4, sampleRate*3/4)); math.Abs(got-want) > want*0.01 {
+						t.Errorf("preserving pitch %v: channel %d of %v Hz plays at %v Hz, want %v", keep, c, f, got, want)
+					}
+					if keep {
+						smooth(t, out, c, 0, sampleRate, f, "stretched")
+					}
+				}
+			}
+		})
+	}
+}
+
+// Stretched, a sound plays for its duration over the speed, and ends
+// where it ends.
+func TestPreservesPitchDuration(t *testing.T) {
+	for _, ch := range []int{1, 2} {
+		freqs := []float64{220, 330}[:ch]
+		s := NewSound(sampleRate, ch, sine(sampleRate, 1, freqs...))
+		for _, speed := range []float64{0.25, 0.5, 1, 1.25, 1.5, 2, 4, 16} {
+			setup(t)
+			p := s.NewPlayer().SetSpeed(speed).SetPreservesPitch(true)
+			ended := make(chan struct{}, 1)
+			p.OnEnd(func() { ended <- struct{}{} })
+			p.Play()
+			out := renderToEnd(t, p)
+			got := frames(int64(framesPlayed(out)), sampleRate)
+			want := time.Duration(float64(time.Second) / speed)
+			// Within a hop.
+			if d := got - want; d < -25*time.Millisecond || d > 25*time.Millisecond {
+				t.Errorf("%d channels at %v×: played %v, want %v", ch, speed, got, want)
+			}
+			if p.Position() != p.Duration() {
+				t.Errorf("%d channels at %v×: Position = %v at the end, want %v", ch, speed, p.Position(), p.Duration())
+			}
+			select {
+			case <-ended:
+			case <-time.After(time.Minute):
+				t.Fatalf("%d channels at %v×: no OnEnd", ch, speed)
+			}
+		}
+	}
+}
+
+// Resampling stays the default: a player gets no stretcher until it
+// preserves pitch, and at speed 1 a stretched one plays as decoded.
+func TestPreservesPitchIsOptIn(t *testing.T) {
+	setup(t)
+	samples := sine(sampleRate, 0.5, 220)
+	p := NewSound(sampleRate, 1, samples).NewPlayer().SetSpeed(1.5).SetPreservesPitch(false)
+	if p.PreservesPitch() || p.v.st != nil {
+		t.Fatalf("PreservesPitch = %v, stretcher %v, by default", p.PreservesPitch(), p.v.st)
+	}
+	p.SetSpeed(1).SetPreservesPitch(true).Play()
+	if !p.PreservesPitch() {
+		t.Error("PreservesPitch = false after SetPreservesPitch(true)")
+	}
+	out := render(sampleRate / 4)
+	for i := range sampleRate / 4 {
+		if !near(out[2*i], samples[i]) {
+			t.Fatalf("frame %d at 1× = %v, want %v as decoded", i, out[2*i], samples[i])
+		}
+	}
+}
+
+// Position follows the source at the speed while stretched, as resampled.
+func TestPreservesPitchPosition(t *testing.T) {
+	setup(t)
+	hold(heldFrames)
+	p := NewSound(sampleRate, 1, sine(sampleRate, 4, 220)).NewPlayer().SetSpeed(1.5).SetPreservesPitch(true)
+	p.Play()
+	render(3 * heldFrames)
+	atFrame(t, p, 3*heldFrames, "200 ms heard at 1.5×")
+	p.SetSpeed(2)
+	render(heldFrames)
+	// Of the 100 ms heard since, all were mixed at 1.5: what changed is
+	// a hop or so behind.
+	atFrame(t, p, 3*heldFrames+heldFrames*3/2, "100 ms more at 1.5×")
+	p.Seek(time.Second)
+	atFrame(t, p, sampleRate, "right after Seek")
+	render(heldFrames + 1000)
+	atFrame(t, p, sampleRate+2000, "1000 frames into the seek at 2×")
+}
+
+// The stretch goes on without a click or a gap as the speed changes, over
+// a loop's seam, and as it turns on and off; a seek starts it over at the
+// frame seeked to.
+func TestStretchIsContinuous(t *testing.T) {
+	setup(t)
+	// 100 periods of 200 Hz: a seamless loop.
+	samples := sine(sampleRate, 0.5, 200)
+	p := NewSound(sampleRate, 1, samples).NewPlayer().SetLoop(true).SetPreservesPitch(true)
+	p.Play()
+	var out []float32
+	for _, speed := range []float64{1, 1.25, 1.5, 2, 3, 0.75, 0.5, 4} {
+		p.SetSpeed(speed)
+		out = append(out, render(sampleRate/5)...)
+	}
+	// 8 × 200 ms at 1.95× on average: 6 loops.
+	smooth(t, out, 0, 0, len(out)/2, 200, "changing speed and looping")
+	if got := dominant(channel(out, 0, 0, len(out)/2)); got != 200 {
+		t.Errorf("plays at %v Hz, want 200", got)
+	}
+
+	p.SetSpeed(1.5)
+	out = render(sampleRate / 5)
+	p.SetPreservesPitch(false)
+	out = append(out, render(sampleRate/5)...)
+	p.SetPreservesPitch(true)
+	out = append(out, render(sampleRate/5)...)
+	smooth(t, out, 0, 0, len(out)/2, 300, "turning on and off")
+	if got := dominant(channel(out, 0, sampleRate/5+2000, 2*sampleRate/5)); got != 300 {
+		t.Errorf("resampled at 1.5× again: %v Hz, want 300", got)
+	}
+	if got := dominant(channel(out, 0, 2*sampleRate/5+2000, 3*sampleRate/5)); got != 200 {
+		t.Errorf("stretched again: %v Hz, want 200", got)
+	}
+
+	setup(t)
+	ramped := ramp(sampleRate)
+	q := NewSound(sampleRate, 1, ramped).NewPlayer().SetSpeed(2).SetPreservesPitch(true)
+	q.Play()
+	render(5000)
+	q.Seek(500 * time.Millisecond)
+	out = render(rampFrames + 20)
+	// What a stretch begins with plays as it is.
+	if i := rampFrames + 10; !near(out[2*i], ramped[24000+i]) {
+		t.Errorf("frame %d after seeking = %v, want %v", i, out[2*i], ramped[24000+i])
+	}
+}
+
+// sineDecoder decodes a sine of amplitude 0.5 in each of ch channels.
+type sineDecoder struct {
+	ch          int
+	hz          float64
+	pos, length int64
+}
+
+func (d *sineDecoder) SampleRate() int { return sampleRate }
+func (d *sineDecoder) Channels() int   { return d.ch }
+func (d *sineDecoder) Len() int64      { return d.length }
+
+func (d *sineDecoder) Read(buf []float32) (int, error) {
+	n := 0
+	for ; n+d.ch <= len(buf) && d.pos < d.length; n += d.ch {
+		for c := range d.ch {
+			buf[n+c] = float32(0.5 * math.Sin(2*math.Pi*d.hz*float64(d.pos)/sampleRate))
+		}
+		d.pos++
+	}
+	if n == 0 {
+		return 0, io.EOF
+	}
+	return n, nil
+}
+
+func (d *sineDecoder) SetPosition(f int64) error { d.pos = f; return nil }
+
+// A stream stretches as a sound does, to its end.
+func TestStreamStretches(t *testing.T) {
+	setup(t)
+	p := NewPlayer(&sineDecoder{ch: 2, hz: 250, length: sampleRate}).SetSpeed(1.5).SetPreservesPitch(true)
+	defer p.Close()
+	p.Play()
+	s := p.v.src.(*stream)
+	var out []float32
+	for p.Playing() {
+		// The decoder keeps a second ahead: wait for it, as the device
+		// would not.
+		for {
+			s.mu.Lock()
+			ok := s.n >= 8192 || s.atEOF
+			s.mu.Unlock()
+			if ok {
+				break
+			}
+			time.Sleep(time.Millisecond)
+		}
+		out = append(out, render(256)...)
+		if len(out) > 10*sampleRate*channels {
+			t.Fatal("10 s and not at its end")
+		}
+	}
+	n := framesPlayed(out)
+	if got, want := frames(int64(n), sampleRate), time.Second*2/3; got < want-25*time.Millisecond || got > want+25*time.Millisecond {
+		t.Errorf("played %v, want %v", got, want)
+	}
+	smooth(t, out, 1, 0, n-2*sampleRate/250, 250, "a stream")
+	if got := dominant(channel(out, 0, 0, n)); got != 250 {
+		t.Errorf("plays at %v Hz, want 250", got)
+	}
+}
+
+// Stretching allocates nothing as it mixes.
+func TestStretchAllocatesNothing(t *testing.T) {
+	setup(t)
+	p := NewSound(sampleRate, 2, sine(sampleRate, 0.5, 200, 300)).NewPlayer().
+		SetLoop(true).SetSpeed(1.5).SetPreservesPitch(true)
+	p.Play()
+	buf := make([]float32, 480*channels)
+	speeds := []float64{1.5, 2, 0.75}
+	i := 0
+	if n := testing.AllocsPerRun(500, func() {
+		mix(buf)
+		if i++; i%50 == 0 {
+			p.SetSpeed(speeds[i/50%len(speeds)])
+		}
+	}); n != 0 {
+		t.Errorf("%v allocations a buffer", n)
+	}
+}
