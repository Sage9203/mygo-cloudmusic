+func wav(tag, bits, ch int, data []byte) []byte {
+	var b bytes.Buffer
+	w := func(v any) { binary.Write(&b, binary.LittleEndian, v) }
+	b.WriteString("RIFF")
+	w(uint32(36 + len(data) + 10))
+	b.WriteString("WAVE")
+	b.WriteString("LIST")
+	w(uint32(1)) // odd, padded
+	b.Write([]byte{0, 0})
+	b.WriteString("fmt ")
+	w(uint32(16))
+	w(uint16(tag))
+	w(uint16(ch))
+	w(uint32(22050))
+	w(uint32(22050 * ch * bits / 8))
+	w(uint16(ch * bits / 8))
+	w(uint16(bits))
+	b.WriteString("data")
+	w(uint32(len(data)))
+	b.Write(data)
+	return b.Bytes()
+}
