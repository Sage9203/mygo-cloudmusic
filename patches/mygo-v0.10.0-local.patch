+// Setting the latency opens the output again, to hold as far ahead as it
+// says.
+func TestSetLatencyReopens(t *testing.T) {
+	setup(t)
+	opened := make(chan time.Duration, 8)
+	openOutput = func(ahead time.Duration, _ outputFormat) (device, int, error) {
+		opened <- ahead
+		return pacedDevice{}, nullFrames, nil
+	}
+	defer func() { openOutput = openDevice }()
+	mu.Lock()
+	testMode = false
+	mu.Unlock()
+	defer func() {
+		mu.Lock()
+		testMode = true
+		latency = LatencyInteractive
+		mu.Unlock()
+	}()
+	p := NewSound(sampleRate, 1, make([]float32, sampleRate)).NewPlayer().SetLoop(true)
+	p.Play()
+	defer p.Close()
+	if got := wait.For(t, "the output to open", opened); got != 40*time.Millisecond {
+		t.Errorf("opened %v ahead, want 40ms", got)
+	}
+	SetLatency(LatencyPlayback)
+	if got := wait.For(t, "the output to open again", opened); got != 250*time.Millisecond {
+		t.Errorf("opened again %v ahead, want 250ms", got)
+	}
+}
+
+// A pacedDevice takes what it is given a little at a time.
+type pacedDevice struct{}
+
+func (pacedDevice) write([]float32) error { time.Sleep(time.Millisecond); return nil }
+func (pacedDevice) close()                {}
+
+// A null device takes as long as what it plays would, on a clock of its
+// own here, does not hurry to catch up once behind, and fails after a
+// while for the device to be tried again.
+func TestNullDeviceKeepsTime(t *testing.T) {
+	start := time.Date(2026, 10, 16, 12, 0, 0, 0, time.UTC)
+	clock := start
+	d := newNullDevice(true)
+	d.next, d.retry = start, start.Add(2*time.Second)
+	d.now = func() time.Time { return clock }
+	d.sleep = func(dt time.Duration) { clock = clock.Add(max(dt, 0)) }
+	chunk := make([]float32, nullFrames*channels) // 10 ms
+	for range 10 {
+		if err := d.write(chunk); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := clock.Sub(start); got != 100*time.Millisecond {
+		t.Errorf("100 ms played in %v", got)
+	}
+	// Late by a second, as after the computer slept: the next chunk takes
+	// its 10 ms from now.
+	clock = clock.Add(time.Second)
+	late := clock
+	if err := d.write(chunk); err != nil {
+		t.Fatal(err)
+	}
+	if got := clock.Sub(late); got != 10*time.Millisecond {
+		t.Errorf("10 ms played late in %v", got)
+	}
+	clock = start.Add(2*time.Second + time.Millisecond)
+	if err := d.write(chunk); err != errRetry {
+		t.Errorf("after 2 s: %v, want errRetry", err)
+	}
+}
+
+// A stream's decoder sleeps while the ring is mostly full, rather than
+// waking on every mix to find nothing to do.
+func TestStreamWakesItsDecoderRarely(t *testing.T) {
+	setup(t)
+	const total = 10 * sampleRate // 10 s
+	d := &heldDecoder{
+		genDecoder: genDecoder{ch: 2, length: total},
+		held:       make(chan struct{}),
+		release:    make(chan struct{}),
+	}
+	p := NewPlayer(d)
+	defer p.Close()
+	s := p.v.src.(*stream)
+	// Count from its first read, while it can't be in the cond's Wait.
+	wait.For(t, "the first read", d.held)
+	s.mu.Lock()
+	wakes := &wakeCounter{Locker: s.cond.L}
+	s.cond.L = wakes
+	s.mu.Unlock()
+	close(d.release)
+	decoded := func(n int) bool {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		return s.n >= n*s.keep || s.atEOF
+	}
+	wait.Until(t, "the ring to fill", func() bool {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		return len(s.ring)-s.n < decodeFrames*s.keep
+	})
+	p.Play()
+	const chunk = 512 // as macOS mixes
+	out := make([]float32, chunk*channels)
+	for range total / chunk {
+		// As fast as the decoder goes, never faster.
+		wait.Until(t, "the stream to decode", func() bool { return decoded(chunk) })
+		mix(out)
+	}
+	s.mu.Lock()
+	n := wakes.n
+	s.mu.Unlock()
+	// Every wake but the last follows a quarter of the ring read, less
+	// the chunk the decoder may have left free.
+	if limit := total/(len(s.ring)/4/s.keep-decodeFrames) + 1; n > limit {
+		t.Errorf("the decoder woke %d times in 10 s, want at most %d", n, limit)
+	}
+}
+
+// A heldDecoder holds its first Read until released.
+type heldDecoder struct {
+	genDecoder
+	held, release chan struct{}
+	once          sync.Once
+}
+
+func (d *heldDecoder) Read(buf []float32) (int, error) {
+	d.once.Do(func() { close(d.held); <-d.release })
+	return d.genDecoder.Read(buf)
+}
+
+// A wakeCounter counts the wakes of a cond whose L it is, as Wait locks
+// L again on each.
+type wakeCounter struct {
+	sync.Locker
+	n int
+}
+
+func (l *wakeCounter) Lock() { l.Locker.Lock(); l.n++ }
+
+// Mixing allocates nothing once playing, sounds and streams alike.
+func TestMixDoesNotAllocate(t *testing.T) {
+	setup(t)
+	p := NewPlayer(&genDecoder{ch: 2, length: 1 << 40})
+	defer p.Close()
+	s := p.v.src.(*stream)
+	wait.Until(t, "the stream to decode", func() bool {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		return s.n > 0
+	})
+	p.Play()
+	// 1.1 s, which ends within the 2.1 s mixed: ending allocates nothing
+	// either.
+	snd := NewSound(22050, 1, ramp(sampleRate/2)).Play()
+	out := make([]float32, 512*channels)
+	if n := testing.AllocsPerRun(200, func() { mix(out) }); n != 0 {
+		t.Errorf("mix allocated %v times a call", n)
+	}
+	if snd.Playing() {
+		t.Error("the sound still plays")
+	}
+}
